# ── Supabase (Project Settings → API) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable / anon key. Safe in the browser: Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret / service-role key. SERVER ONLY. Used only by `npm run seed`.
SUPABASE_SERVICE_ROLE_KEY=

# ── Demo organizer account (created by `npm run seed`) ────────────
DEMO_EMAIL=demo@classpilot.app
DEMO_PASSWORD=change-me-demo-2026

# ── Groq AI assistant (console.groq.com → API Keys, starts with "gsk_") ──
# SERVER ONLY, never prefix with NEXT_PUBLIC
GROQ_API_KEY=
# Optional overrides
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── WhatsApp sharing (optional) ───────────────────────────────────
# Number prefilled in the share dialog's "Phone number" option.
NEXT_PUBLIC_WHATSAPP_TEST_NUMBER=
